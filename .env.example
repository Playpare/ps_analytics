# ---------------------------------------------------------------------------
# Apps Script web app endpoints
# ---------------------------------------------------------------------------
# Copy this file to .env.local and paste the real /exec URLs. .env.local is
# gitignored, so the public repo never carries them.
#
# These are NOT secrets in the cryptographic sense - every request still has to
# carry a token signed with AUTH_HMAC_SECRET_V1, which lives server-side only.
# They are kept out of the repo because a published endpoint invites unwanted
# traffic against an Apps Script execution quota shared across all six
# deployments, and a throttled deployment takes the whole dashboard down.
#
# In CI these come from GitHub Actions secrets of the same name - see
# .github/workflows/deploy.yml.
#
# Each URL must end in /exec (not /dev) and the deployment must be configured
# "Execute as: Me" + "Who has access: Anyone".

# Login-only deployment: standalone project, no bound workbook, one daily
# trigger. Kept separate on purpose so a sign-in never queues behind a
# workbook rebuild.
VITE_API_AUTH=https://script.google.com/macros/s/REPLACE_ME/exec

VITE_API_UA=https://script.google.com/macros/s/REPLACE_ME/exec
VITE_API_WEEKLY=https://script.google.com/macros/s/REPLACE_ME/exec
VITE_API_TILLDATE=https://script.google.com/macros/s/REPLACE_ME/exec
VITE_API_ASO=https://script.google.com/macros/s/REPLACE_ME/exec
VITE_API_NEGATIVE=https://script.google.com/macros/s/REPLACE_ME/exec

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Base public path. Leave as ./ for GitHub Pages project sites and local
# preview alike; set to / only if the app is served from a domain root.
VITE_BASE=./

# Game Analytics: the dashboard the five reports are being folded into.
# The key is not a security control - see src/shared/config.js. It is kept out
# of the repo for the same reason the URLs are.
VITE_API_GAME=https://script.google.com/macros/s/REPLACE_ME/exec
VITE_API_GAME_KEY=REPLACE_ME
